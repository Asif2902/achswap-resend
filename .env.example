# Get yours at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# Optional: change port
PORT=3000
EMAIL_DOMAIN=achswap.app

# Same remote database used by the Cloudflare inbound Worker. Server-only values.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_database_token

# ---- Team login (server-side only — set real values in `.env` locally
# and in Vercel Dashboard -> Settings -> Environment Variables) ----
# Random 32-byte hex string used to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change_me_to_a_long_random_string

# Each team member logs in with their email + password below.
# Each gets support@achswap.app + admin@achswap.app + their OWN personal address.
# e.g. Asif -> support/admin/asif@, never sukanto@/hossain@ (enforced server-side).
# NOTE: passwords contain `#`, so in the local `.env` file they MUST be
# wrapped in double quotes. In the Vercel Dashboard paste them WITHOUT quotes.
USER_HOSSAIN_EMAIL=hossain@achswap.app
USER_HOSSAIN_PASS="change_me"

USER_SUKANTO_EMAIL=sukanto@achswap.app
USER_SUKANTO_PASS="change_me"

USER_ASIF_EMAIL=asif@achswap.app
USER_ASIF_PASS="change_me"

# Optional dynamic team configuration, replaces the three legacy USER_* entries.
# TEAM_USERS_JSON='[{"email":"asif@achswap.app","password":"a-unique-password"},{"email":"john@achswap.app","password":"another-unique-password"}]'
