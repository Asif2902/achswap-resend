    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "dom-serializer": "^2.0.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
