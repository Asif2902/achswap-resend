{
  "name": "achswap-mailer",
  "version": "1.0.0",
  "description": "Simple Resend mail sender for support@achswap.app",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/mailbox.test.js test/email-html.test.js",
    "test:ui": "playwright test",
